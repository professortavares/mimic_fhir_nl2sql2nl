# Host do banco Postgres
# Use 'host.docker.internal' ao rodar dentro do Docker
# Use 'localhost' ao rodar localmente
POSTGRES_HOST=

# Porta padrão do Postgres
POSTGRES_PORT=5432

# Nome do banco de dados
POSTGRES_DB=

# Usuário do banco
POSTGRES_USER=

# Senha do banco
POSTGRES_PASSWORD=

# Chave de API da OpenAI (obtenha em https://platform.openai.com/api-keys)
OPENAI_API_KEY=
